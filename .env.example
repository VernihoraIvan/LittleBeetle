# Backend API (local: http://localhost:3001, production: https://littlebeetle-backend-nestjs-production.up.railway.app)
VITE_API_BASE_URL=http://localhost:3001
# Stripe publishable key (pk_test_... for testing, pk_live_... in production)
VITE_STRIPE_PUBLIC=
# Multiplier applied to delivery fees (defaults to 1 when unset)
VITE_DELIVERY_COEFFICIENT=
